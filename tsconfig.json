{
  // Type-check only (noEmit). Execution is handled by Playwright (config / tests /
  // helpers / reporters) and Node native TS (scripts/*.mts); there is no separate
  // build step. Mirrors the recipely app's strict TypeScript posture.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": false
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "helpers/**/*.ts",
    "reporters/**/*.ts",
    "scripts/**/*.mts"
  ],
  "exclude": ["node_modules", "playwright-report", "test-results", "artifacts"]
}
